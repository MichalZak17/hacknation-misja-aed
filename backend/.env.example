# Copy to .env (gitignored). Read by config/settings.py and docker-compose.yml. No Doppler in this project.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

POSTGRES_DB=misja_aed
POSTGRES_USER=misja_aed
POSTGRES_PASSWORD=misja_aed
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

REDIS_PORT=6380
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
REDIS_CACHE_URL=redis://127.0.0.1:6380/1
# true = run syncs inline instead of on the Celery worker (handy for debugging)
CELERY_TASK_ALWAYS_EAGER=false

# The one admin login, created or updated by `manage.py ensure_admin` (npm run backend runs it)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# Points from two sources closer than this become a duplicate candidate for review
MATCH_DISTANCE_M=25
# HTTP client identity for source downloads
HTTP_USER_AGENT=MisjaAED-prototype/0.1 (HackNation 2026)

# Public origin of the site (absolute links in /api/export/dataset.json). Unset = first DJANGO_CSRF_TRUSTED_ORIGINS entry.
# PUBLIC_BASE_URL=https://aed.example.pl
# Licence for the dataset on dane.gov.pl, one of: CC0 1.0 | CC BY 4.0 | CC BY-SA 4.0 (default CC BY-SA 4.0, closest to
# the ODbL of the OpenStreetMap part). Empty = none (the harvester XML then carries no licence conditions).
# DATASET_LICENSE=CC BY-SA 4.0
# Other origins the site is reachable at; requests through them get export links on that origin (comma-separated)
# EXTRA_PUBLIC_BASE_URLS=https://aed-test.example.pl

# Local LLM that reads structured facts (placement, floor, hours, access conditions) out of source free text during
# syncs. Off by default; the shared hacknation-dev vLLM serves Qwen3.8-27B as "qwen". Benchmark and choice of model:
# docs/llm-extraction/report.mdx. LLM_CONCURRENCY should not exceed the server's --max-num-seqs (16 there).
LLM_ENABLED=false
LLM_BASE_URL=http://100.78.88.117:8000/v1
LLM_MODEL=qwen
LLM_CONCURRENCY=16
LLM_TIMEOUT=120
